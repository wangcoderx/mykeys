    },
    {
      "id": "csg8Zg1JJWsXUsbxIm7XH",
      "type": "text",
      "x": 1459.2647163347997,
      "y": 1119.1693852434462,
      "width": 1043.139892578125,
      "height": 100,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b36",
      "roundness": null,
      "seed": 789595070,
      "version": 515,
      "versionNonce": 2107487714,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1789225095026,
      "created": 1789224974118,
      "link": null,
      "locked": false,
      "text": "注意事项：修改密码后，需要对现有的所有的 api 秘钥进行重新加密，并保证如果用户突然关闭，再次重启可以续加密\n放弃一切：模式是删除所有的存储的秘钥和密码。\n上述两个操作均需要点击后弹出一个提示框（当前操作 1/10 个，Sk—***********cb）\n",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "注意事项：修改密码后，需要对现有的所有的 api 秘钥进行重新加密，并保证如果用户突然关闭，再次重启可以续加密\n放弃一切：模式是删除所有的存储的秘钥和密码。\n上述两个操作均需要点击后弹出一个提示框（当前操作 1/10 个，Sk—***********cb）\n",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
